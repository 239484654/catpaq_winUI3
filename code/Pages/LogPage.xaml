<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Catpaq.Pages.LogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Catpaq.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ABORT 工具栏（橙色，默认隐藏） -->
        <Grid
            x:Name="AbortBar"
            Grid.Row="0"
            Background="#FF8020"
            Padding="8,4"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnAbort" Grid.Column="0" Content="ABORT" FontWeight="Bold" Click="BtnAbort_Click" />
            <TextBlock
                x:Name="LblStatus"
                Grid.Column="1"
                Text="Loading archive..."
                Foreground="White"
                FontWeight="Bold"
                VerticalAlignment="Center"
                Margin="12,0,0,0" />
        </Grid>

        <!-- 系统日志 / 归档日志 -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="LblSystemLog" Grid.Row="0" Text="System log" FontWeight="SemiBold" Margin="4" />
                <TextBox
                    x:Name="SystemLog"
                    Grid.Row="1"
                    IsReadOnly="True"
                    AcceptsReturn="True"
                    TextWrapping="NoWrap"
                    FontFamily="Consolas"
                    ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </Grid>

            <Border
                Grid.Row="1"
                Height="6"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <Grid Grid.Row="2" Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="LblArchiveLog" Grid.Row="0" Text="Archive log" FontWeight="SemiBold" Margin="4" />
                <TextBox
                    x:Name="ArchiveLog"
                    Grid.Row="1"
                    IsReadOnly="True"
                    AcceptsReturn="True"
                    TextWrapping="NoWrap"
                    FontFamily="Consolas"
                    ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Grid>

        <!-- 进度条 -->
        <ProgressBar
            x:Name="Gauge"
            Grid.Row="2"
            Minimum="0"
            Maximum="100"
            Value="0"
            Margin="4" />
    </Grid>
</Page>
