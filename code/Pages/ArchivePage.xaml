<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Catpaq.Pages.ArchivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Catpaq.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏：归档信息 + 按钮 -->
        <Grid Grid.Row="0" Padding="8,8,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="LblArchiveInfo"
                Grid.Column="0"
                Text="No archive loaded"
                FontWeight="SemiBold"
                VerticalAlignment="Center" />
            <Button x:Name="BtnOpen" Grid.Column="1" Content="Select ZPAQ..." Click="BtnOpen_Click" />
            <Button x:Name="BtnTimeMachine" Grid.Column="2" Margin="8,0,0,0" Content="Show ALL versions" Click="BtnTimeMachine_Click" />
        </Grid>

        <!-- 过滤行 -->
        <Grid Grid.Row="1" Padding="8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LblFilter" Grid.Column="0" Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="EdtFilter" Grid.Column="1" KeyDown="EdtFilter_KeyDown" />
            <TextBlock x:Name="LblFileCount" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Text="0 files" />
        </Grid>

        <!-- 文件树（含版本历史） -->
        <TreeView
            x:Name="FileTree"
            Grid.Row="2"
            Margin="8,4"
            ItemInvoked="FileTree_ItemInvoked"
            RightTapped="FileTree_RightTapped" />

        <!-- 时间机滑块 -->
        <Slider
            x:Name="TimeSlider"
            Grid.Row="3"
            Margin="8,4"
            Minimum="0"
            Maximum="1"
            ValueChanged="TimeSlider_ValueChanged"
            IsEnabled="False" />

        <!-- 底部：加载信息 + 进度 -->
        <Grid Grid.Row="4" Padding="8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LblLoadInfo" Grid.Column="0" Text="" />
            <ProgressBar x:Name="LoadGauge" Grid.Column="1" Minimum="0" Maximum="100" Value="0" />
        </Grid>
    </Grid>
</Page>
