<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Catpaq.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24,20" Spacing="10" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock x:Name="LblTitle" Text="About Catpaq" FontSize="24" FontWeight="Bold" />
            <TextBlock x:Name="LblBody" Text="" TextWrapping="Wrap" IsTextSelectionEnabled="True" LineHeight="22" />
        </StackPanel>
    </ScrollViewer>
</Page>
